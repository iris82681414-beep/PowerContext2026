{
  "task": "renewal",
  "sources": [
    {
      "path": "policy.md",
      "kind": "specification",
      "body": "# Renewal policy v1\n\nLoan renewal normally grants 14 days. Members receive a 21-day renewal when nobody else has reserved the item. Any reservation prevents renewal for all borrowers. Keep the function signature and the existing reservation and ordinary borrower behavior.\n",
      "digest": "429f0628b6c0abbe7a303d36ab40cfb66c09e7d6201ecd366d1963e440c32b48",
      "score": 0.30640668523676884
    },
    {
      "path": "loan.py",
      "kind": "source",
      "body": "\"\"\"Loan renewal business rules.\"\"\"\n\ndef renewal_days(*, member: bool, has_reservation: bool) -> int:\n    if has_reservation:\n        return 0\n    if member:\n        return 21\n    return 14\n",
      "digest": "bac6655e0a39ed7db69983f1fbbc2e0de03dea35fb1be954a1c3f308419b5423",
      "score": 0.20072992700729927
    },
    {
      "path": "test_loan.py",
      "kind": "test",
      "body": "\"\"\"Regression checks for loan renewal.\"\"\"\n\nimport unittest\n\nfrom loan import renewal_days\n\n\nclass RenewalTests(unittest.TestCase):\n    def test_member_renewal(self):\n        self.assertEqual(renewal_days(member=True, has_reservation=False), 21)\n\n    def test_regular_renewal(self):\n        self.assertEqual(renewal_days(member=False, has_reservation=False), 14)\n\n    def test_reservation_prevents_renewal(self):\n        for member in (True, False):\n            with self.subTest(member=member):\n                self.assertEqual(renewal_days(member=member, has_reservation=True), 0)\n\n\nif __name__ == '__main__':\n    unittest.main()\n",
      "digest": "a59fa7038ff67710b1c618258717e763c2b7276d837d0f2cf473eda2308b7f58",
      "score": 0.08928571428571427
    }
  ],
